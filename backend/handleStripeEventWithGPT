async function updateXeroInvoiceStatus(invoiceId, status) {
  const xeroApiUrl = `https://api.xero.com/api.xro/2.0/Invoices/${invoiceId}`;
  const token = process.env.XERO_ACCESS_TOKEN;

  // Le corps JSON de la mise à jour dépend de l'API Xero (ici un exemple théorique)
  const body = {
    Status: status
  };

  const response = await axios.post(xeroApiUrl, body, {
    headers: {
      Authorization: `Bearer ${token}`,
      'Content-Type': 'application/json'
    }
  });

  return response.data;
}

