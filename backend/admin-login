app.post('/admin-login', (req, res) => {
  const { password } = req.body;
  if (password !== process.env.ADMIN_PASSWORD) return res.status(401).send("Wrong password");
  const token = jwt.sign({ admin: true }, process.env.JWT_SECRET, { expiresIn: '1h' });
  res.json({ token });
});

app.get('/messages', authenticateJWT, async (req, res) => {
  const messages = await prisma.message.findMany({ include: { client: true } });
  res.json(messages);
});

function authenticateJWT(req, res, next) {
  const auth = req.headers.authorization;
  if (!auth) return res.sendStatus(403);
  const token = auth.split(" ")[1];
  jwt.verify(token, process.env.JWT_SECRET, (err, decoded) => {
    if (err || !decoded.admin) return res.sendStatus(403);
    next();
  });
}
