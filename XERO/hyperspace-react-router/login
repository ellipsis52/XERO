import { useEffect, useState } from 'react';
import axios from 'axios';
import { saveAs } from 'file-saver';

export default function AdminDashboard() {
  const [messages, setMessages] = useState([]);
  const [editing, setEditing] = useState(null);
  const [newPrompt, setNewPrompt] = useState('');

  useEffect(() => {
    fetchMessages();
  }, []);

  const fetchMessages = async () => {
    const res = await axios.get('/api/messages/all');
    setMessages(res.data);
  };

  const handleResend = async (id) => {
    await axios.post(`/api/messages/resend/${id}`);
    fetchMessages();
  };

  const handleEdit = async (id) => {
    await axios.put(`/api/messages/${id}`, { prompt: newPrompt });
    setEditing(null);
    fetchMessages();
  };

  const exportCSV = () => {
    const csv = messages.map(msg =>
      `"${msg.id}","${msg.prompt.replace(/"/g, '""')}","${msg.response.replace(/"/g, '""')}"`
    ).join('\n');
    const blob = new Blob([`"ID","Prompt","Response"\n${csv}`], { type: 'text/csv;charset=utf-8;' });
    saveAs(blob, 'messages.csv');
  };

  return (
    <div className="p-4">
      <h1 className="mb-4 text-2xl font-bold">Tableau de bord GPT</h1>
      <button onClick={exportCSV} className="px-4 py-2 mb-4 text-white bg-green-600 rounded">📤 Export CSV</button>
      <div className="overflow-x-auto">
        <table className="w-full border border-gray-300 table-auto">
          <thead>
            <tr className="bg-gray-200">
              <th className="p-2 border">Prompt</th>
              <th className="p-2 border">Réponse</th>
              <th className="p-2 border">Actions</th>
            </tr>
          </thead>
          <tbody>
            {messages.map(msg => (
              <tr key={msg.id}>
                <td className="w-1/3 p-2 border">
                  {editing === msg.id ? (
                    <textarea
                      value={newPrompt}
                      onChange={(e) => setNewPrompt(e.target.value)}
                      className="w-full p-1 border"
                    />
                  ) : (
                    msg.prompt
                  )}
                </td>
                <td className="p-2 border">{msg.response}</td>
                <td className="flex flex-col gap-1 p-2 border">
                  <button onClick={() => handleResend(msg.id)} className="px-2 py-1 text-white bg-blue-500 rounded">🔁 Resend</button>
                  {editing === msg.id ? (
                    <>
                      <button onClick={() => handleEdit(msg.id)} className="px-2 py-1 text-white bg-green-500 rounded">✅ Enregistrer</button>
                      <button onClick={() => setEditing(null)} className="px-2 py-1 text-white bg-gray-400 rounded">❌ Annuler</button>
                    </>
                  ) : (
                    <button onClick={() => { setEditing(msg.id); setNewPrompt(msg.prompt); }} className="px-2 py-1 text-white bg-yellow-500 rounded">✏️ Modifier</button>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
