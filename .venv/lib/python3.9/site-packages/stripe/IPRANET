// Exemple de fonction qui crée une facture dans Xero via l'API
async function createInvoice(invoiceData) {
  try {
    const response = await axios.post(`${api_url}Invoices`, invoiceData, {
      headers: {
        Authorization: `Bearer ${accessToken}`,
        'Xero-tenant-id': 'your_tenant_id',
      }
    });
    console.log('Invoice created:', response.data);
  } catch (error) {
    console.error('Error creating invoice:', error);
  }
}

// Exemple d'appel avec un objet de facture
const invoice = {
  Type: 'ACCREC',
  Contact: {
    ContactID: 'your_contact_id',
  },
  LineItems: [
    {
      Description: 'Service rendered',
      Quantity: 1,
      UnitAmount: 100,
      AccountCode: '200',
    }
  ],
  Date: '2025-06-30',
  DueDate: '2025-07-30',
};

// Appel de la fonction pour créer la facture
